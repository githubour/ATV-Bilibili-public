# ============================================
#  local.env.example —— 本机私有配置模板
#
#  用法:
#    cp local.env.example local.env
#  然后按下面注释填自己的值。
#
#  local.env 已被 .gitignore 忽略，永不入库；反过来也成立 ——
#  真实的 UDID / Team ID / 内网地址不要写进任何会入库的文件
#  （.command / .sh / .swift / 文档都不行）。
#
#  只想装机的话，最少填 ATV_UDID 与 ATV_TEAM_ID 两项。
# ============================================

# Apple TV 的 UDID（必填）
# 查法: xcrun devicectl list devices
ATV_UDID="00008110-XXXXXXXXXXXXXX"

# 免费个人开发者 Team ID（必填，10 位大写字母+数字）
# 查法: Xcode → 设置 → Accounts → 选中 Apple ID → 右侧 Team ID
ATV_TEAM_ID="YYYYYYYYYY"

# Apple TV 的局域网 IP（可选）
# 只用于「导出公共版」时替换成示例地址；不知道就留空
ATV_DEVICE_IP=""

# 导出/推送公共仓库时用的内网代理（可选，留空则只试直连）
# 例: http://proxy.local:7890
ATV_PROXY=""

# 本仓库的绝对路径（可选）
# 自动续签 watchdog 跑在内置盘上，靠它找到项目里的续签脚本；
# 留空则取脚本所在目录
ATV_PROJECT_DIR=""

# Bilibili for iOS 项目路径（可选）
# 自动续签 Bilibili for iOS 时调用该目录下的 本机-装机-iOS.command；
# 留空则该版不参与续签
ATV_BILI_IOS_DIR=""

# Bilibili for iOS 的两个真机 UDID（可选）
# 两台共用同一份描述文件（com.example.bilibiliipad），都要登记进 Apple ID 设备列表；
# 留空则该版不参与续签（两个都必须填，缺一个就不纳入目标表）
ATV_BILI_IPHONE_UDID="00008120-XXXXXXXXXXXXXX"
ATV_BILI_IPAD_UDID="00008130-XXXXXXXXXXXXXX"

# ZenPlayer 项目路径（可选）
# 自动续签 ZenPlayer（com.yourname.zenplayer）时调用它自己的 M1-装机.command；
# 留空则该版不参与续签
ATV_ZEN_DIR=""

# ZenPlayer iOS 项目路径（可选）
# 自动续签 ZenPlayer iOS（com.yourname.zenplayer.ios，iPhone + iPad）时调用
# 该目录下的 装机.command；留空则该版不参与续签
ZEN_IOS_DIR=""

# ZetaBrowser iOS 项目路径（可选）
# 自动续签 ZetaBrowser（com.yourname.zetabrowser.ios，iPhone）时调用
# 该目录下的 装机.command；留空则该版不参与续签
ZETA_IOS_DIR=""

# 测试用 tvOS 模拟器 UDID（可选；pre-push 钩子会读它，未填则钩子直接拒推）
# 查法: xcrun simctl list devices（挑一台 tvOS 设备，取其括号里的 UDID）
# 只认这一台，不存在就拒推，不会回退到别的同型号设备
ATV_TEST_SIMULATOR_ID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
